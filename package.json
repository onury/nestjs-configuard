{
  "name": "nestjs-configuard",
  "version": "1.0.0",
  "description": "NestJS integration for configuard — DB-backed, typed, ABAC-filtered runtime configuration with live reload and TTL auto-refresh.",
  "type": "module",
  "license": "MIT",
  "author": "Onur Yıldırım",
  "homepage": "https://github.com/onury/nestjs-configuard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onury/nestjs-configuard.git"
  },
  "bugs": {
    "url": "https://github.com/onury/nestjs-configuard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "nest",
    "configuard",
    "config",
    "configuration",
    "settings",
    "abac",
    "dynamic-config",
    "runtime-config",
    "prisma"
  ],
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "configuard": "^1",
    "reflect-metadata": "^0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-istanbul": "^4.1.8",
    "biome-config-oy": "^1.1.0",
    "configuard": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
